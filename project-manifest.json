{
  "name": "personal-webos",
  "version": "1.1.0",
  "productVersionTarget": "5.0.0",
  "releaseStatus": "development",
  "title": "Personal Web OS — Personal CMS & Private Workspace",
  "author": "admin",
  "architecture": {
    "framework": "Next.js 16 (App Router) + React 19 + TypeScript",
    "styling": "Tailwind CSS v4 + Nolane UI (NUI) Editorial Bàn Giấy Design Tokens",
    "orm": "Drizzle ORM",
    "database": "Production: PostgreSQL configured via DATABASE_URL; development/test: embedded PGlite WASM. Production data is server-backed; local-first remains a target rather than a completed guarantee.",
    "security": {
      "passwordHashing": "Bcrypt (12 rounds salt)",
      "sessionTokens": "256-bit cryptographically secure, SHA-256 hashed in DB",
      "cookiePolicy": "HttpOnly, Secure in production, SameSite=Lax",
      "rateLimiter": "In-memory sliding-window limiter; not a shared global counter across every production instance",
      "xssProtection": "isomorphic-dompurify HTML sanitization",
      "vaultEncryption": "Client-side Web Crypto AES-256-GCM; PBKDF2-HMAC-SHA-256 at 600000 iterations for new items, legacy 100000-iteration decryption fallback",
      "panicLock": "Global Ctrl+Shift+L privacy overlay with account re-authentication; not a secure RAM wipe or OS lock",
      "zeroDefaultCredentials": true,
      "guestSessionZeroKnowledge": true,
      "contentRevisions": true,
      "softDeleteTrash": true,
      "aiDataFlow": "Copilot API key is session/component state only; retrieval context is opt-in; external provider requests leave the browser and are subject to provider/network policies"
    },
    "edgeGateway": {
      "engine": "Cloudflare Worker (Wrangler)",
      "features": [
        "Bot Scanner Blocking",
        "Per-isolate in-memory rate limiting",
        "HSTS & Security Headers Injection",
        "Upstream Proxy"
      ]
    },
    "ciCd": {
      "pipeline": ".github/workflows/ci.yml",
      "edgeDeployment": ".github/workflows/cloudflare-worker.yml"
    },
    "functionalStatus": {
      "copilot": "Real OpenAI-compatible/Groq/Ollama requests and real API-backed keyword retrieval; not a full RAG or agent runtime",
      "workflows": "Persistent workflows; currently supports Inbox-to-task and read-only overdue-report executors; other trigger types are explicitly unsupported",
      "creatorStudio": "Database-backed content pipeline and optional direct AI outline generation; external publishing is not implemented by this module",
      "calendarHabits": "Database-backed internal events and habit completion tracking; no external calendar sync",
      "backups": "Versioned JSON export and transactional import; wiki links, revisions, habits and calendar events are included, but standalone export checksum/manifest verification is not yet implemented",
      "audioLab": "Procedural multi-layer Web Audio mixer with independent layer/master gain and spectrum from AnalyserNode; external radio remains third-party and failure is surfaced",
      "wallpaperStudio": "Wallpaper library CRUD validates media/URL input, surfaces save/delete/favorite errors and persists large asset selection by database ID to avoid storing the full Data URL in localStorage"
    }
  },
