# Personal Web OS Environment Configuration
# Môi trường chạy hệ điều hành Web cá nhân

# Tùy chọn cơ sở dữ liệu (PostgreSQL / Supabase)
# Nếu để trống, hệ thống tự động kích hoạt cơ sở dữ liệu nhúng PGlite WASM (zero-config, lưu tại ./data/webos_pglite)
DATABASE_URL=postgres://postgres:password@localhost:5432/webos

# Chế độ môi trường (development / production / test)
NODE_ENV=development

# Cấu hình bảo mật phiên
# Thời hạn phiên làm việc mặc định: 30 ngày (đối với thiết bị tin cậy) hoặc 1 ngày
SESSION_MAX_AGE_DAYS=30

# URL của hệ thống (dùng cho CORS hoặc Webhook nếu cần)
NEXT_PUBLIC_APP_URL=http://localhost:3000
